{
  "name": "nullshell",
  "version": "1.0.0",
  "private": true,
  "description": "NULLSHELL — scroll-scrubbed cinematic landing page (dark terminal-green theme)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "PORT=8099 HOST=0.0.0.0 NODE_ENV=development node server.js",
    "build": "node build.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "deploy": "bash deploy/deploy.sh",
    "pm2:start": "npm ci --omit=dev && npm run build && pm2 start ecosystem.config.js && pm2 save",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:logs": "pm2 logs nullshell"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
